<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The calendar permission's card, on Today and in Settings. -->
    <string name="permission_title">Tempo cannot read your calendar yet</string>
    <string name="permission_body">To show your events, Tempo needs to read the phone’s calendar. It only reads: creating and changing events stay in your calendar app.</string>
    <string name="permission_allow">Allow</string>
    <string name="permission_denied_body">You turned this permission off. Android only lets you turn it back on from the app’s page in the phone’s settings, under Permissions, Calendar.</string>
    <string name="permission_open_settings">Open the app’s settings</string>

    <string name="event_no_title">(No title)</string>
    <string name="time_range">%1$s – %2$s</string>
    <string name="date_span">From %1$s to %2$s</string>
    <string name="date_span_tomorrow">From tomorrow to %1$s</string>
    <string name="time_from">from %1$s</string>
    <string name="time_until">until %1$s</string>
    <!-- An end on a later date (%1$s the time, %2$s the weekday or the date, as written mid-sentence). -->
    <string name="time_until_tomorrow">until tomorrow at %1$s</string>
    <string name="time_until_day">until %2$s at %1$s</string>
    <string name="duration_m">%1$d min</string>
    <string name="duration_h">%1$d h</string>
    <string name="duration_hm">%1$d h %2$d min</string>

    <!-- The day's sentence (PLANNING.md §6). Each case is a whole clause; the endings follow. -->
    <!-- %1$s the event, %2$s its end: "until 11:00", "until tomorrow at 6:00" (time_until*). -->
    <string name="sentence_under_way">%1$s %2$s</string>
    <plurals name="sentence_soon">
        <item quantity="one">%1$s in %2$d minute</item>
        <item quantity="other">%1$s in %2$d minutes</item>
    </plurals>
    <string name="sentence_free_until">Free until %1$s, then %2$s</string>
    <plurals name="sentence_then_more">
        <item quantity="one">, then one more today.</item>
        <item quantity="other">, then %1$d more today.</item>
    </plurals>
    <plurals name="sentence_and_more">
        <item quantity="one">, and one more after it.</item>
        <item quantity="other">, and %1$d more after it.</item>
    </plurals>
    <string name="sentence_end">.</string>
    <string name="sentence_last">, the last today.</string>
    <string name="sentence_done_tomorrow">Nothing left today; tomorrow starts at %1$s with %2$s.</string>
    <string name="sentence_done_tomorrow_free">Nothing left today, and tomorrow is free.</string>
    <string name="sentence_done">Nothing left today.</string>
    <string name="sentence_free_day_tomorrow">Nothing on the calendar today; tomorrow starts at %1$s with %2$s.</string>
    <string name="sentence_free_day_tomorrow_free">Nothing on the calendar today or tomorrow.</string>
    <string name="sentence_free_day">Nothing on the calendar today.</string>

    <!-- A day after today, in a few words. -->
    <plurals name="summary_events">
        <item quantity="one">%1$d event, %2$s to %3$s.</item>
        <item quantity="other">%1$d events, %2$s to %3$s.</item>
    </plurals>
    <plurals name="summary_events_count">
        <item quantity="one">%1$d event.</item>
        <item quantity="other">%1$d events.</item>
    </plurals>
    <plurals name="summary_all_day">
        <item quantity="one">%1$d all-day event.</item>
        <item quantity="other">%1$d all-day events.</item>
    </plurals>
    <string name="summary_nothing">Nothing planned.</string>
    <plurals name="summary_nothing_days">
        <item quantity="one">%1$d day with nothing planned.</item>
        <item quantity="other">%1$d days with nothing planned.</item>
    </plurals>

    <string name="alarm_today">Alarm at %1$s</string>
    <string name="alarm_tomorrow">Alarm tomorrow at %1$s</string>
    <string name="alarm_on">Alarm %1$s at %2$s</string>

    <!-- Time zones (step 8.5). An event's start in the zone it was written in, where the phone's
         clock reads another time: %1$s the time, %2$s the zone's city ("09:00 in Lisbon"). -->
    <string name="time_in_zone">%1$s in %2$s</string>
    <!-- The second clock: %1$s the city, %2$s its time; then its date where it is not the phone's. -->
    <string name="second_clock">%1$s %2$s</string>
    <string name="second_clock_tomorrow">%1$s %2$s · tomorrow</string>
    <string name="second_clock_yesterday">%1$s %2$s · yesterday</string>
    <!-- %3$s the weekday, two dates away (UTC+14 beside UTC−10). -->
    <string name="second_clock_day">%1$s %2$s · %3$s</string>
    <!-- A city in the list of time zones, and its offset from UTC ("+1", "−3", "+5:30"). -->
    <string name="zone_city_country">%1$s, %2$s</string>
    <string name="zone_offset">UTC%1$s</string>

    <!-- A day's rows, on every page that lists a day (Today, the month). -->
    <string name="agenda_open_day">Open the day in your calendar</string>
    <string name="agenda_new_event">New event</string>
    <string name="agenda_all_day">All day</string>
    <string name="agenda_day_of">Day %1$d of %2$d</string>
    <string name="agenda_left">%1$s left</string>
    <string name="agenda_started_before">Started the day before</string>
    <string name="agenda_ends_after">Ends the next day</string>
    <!-- %1$s a weekday ("Monday") or, further away, a date ("Monday 5 October"). -->
    <string name="agenda_started_on">Started %1$s</string>
    <string name="agenda_ends_on">Ends %1$s</string>
    <string name="agenda_declined">Declined</string>
    <string name="agenda_maybe">Maybe</string>
    <!-- An invitation the reader has not answered yet. -->
    <string name="agenda_not_answered">Not answered</string>

    <!-- What TalkBack reads for a row: one sentence. -->
    <string name="a11y_range">%1$s to %2$s</string>
    <string name="a11y_in_calendar">in %1$s</string>
    <string name="a11y_under_way">under way, %1$s left</string>
    <string name="a11y_over">over</string>
    <string name="a11y_declined">declined</string>
    <string name="a11y_maybe">maybe</string>
    <string name="a11y_not_answered">not answered yet</string>
    <string name="a11y_open_event">Open in your calendar</string>

    <!-- The states an agenda's place says in a card, before any event. -->
    <string name="state_no_calendars_title">There is no calendar on this phone yet</string>
    <string name="state_no_calendars_body">Add one in your calendar app, or add an account that has one in the phone’s settings: its events appear here.</string>
    <string name="state_all_hidden_title">Every calendar is hidden</string>
    <string name="state_all_hidden_body">Tempo shows only the calendars you choose, and right now none is chosen.</string>
    <string name="state_all_hidden_action">Choose calendars</string>
    <string name="state_no_app_title">No calendar app on this phone</string>
    <string name="state_no_app_body">Tempo shows your events, but opening or creating one happens in a calendar app, such as Google Calendar or Etar.</string>
</resources>
