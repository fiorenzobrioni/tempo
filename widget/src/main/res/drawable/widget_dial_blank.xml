<?xml version="1.0" encoding="utf-8"?>
<!--
  The AnalogClock's own dial, left empty: the face is the bitmap under it (WidgetDial.kt). Its size
  is what the clock scales its hands against, so it is the hands' HAND_DRAWABLE_DP.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0 L1,0 L1,1 Z" />
</vector>
