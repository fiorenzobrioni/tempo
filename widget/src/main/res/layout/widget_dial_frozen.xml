<?xml version="1.0" encoding="utf-8"?>
<!--
  The «In words» dial frozen at a sample's moment (the samples, the previews, the pictures): the
  face with the hands painted in (WidgetDial.kt), so it shows the sample's time.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dial"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_dial_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</FrameLayout>
