<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The activity draws its own Compose theme; this only gives the window a sane background
         before the first frame. DayNight, because Tempo follows the system; no action bar,
         because the platform's would print the app label above the Compose UI. -->
    <style name="Theme.Tempo" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
