<?xml version="1.0" encoding="utf-8"?>
<!-- The "New event" shortcut's mark (PLANNING.md §8): the page and plus in white over the
     launcher icon's ground (ic_launcher_background, written by tools/draw_launcher_icon.py), as
     an adaptive icon, so the launcher gives it the shape it gives every icon. Drawn as a disc it
     kept its shape only under a round mask: under any other the launcher shrank it onto a white
     plate (owner, 9 Nov 2026). The glyph is the themed layer too, read by its alpha. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_new_event_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_new_event_foreground" />
</adaptive-icon>
