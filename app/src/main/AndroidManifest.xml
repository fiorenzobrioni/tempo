<?xml version="1.0" encoding="utf-8"?>
<!--
  Tempo's permissions are the short list in PLANNING.md §10: READ_CALENDAR (Phase 1, declared by
  :core:calendar next to the code that reads the provider) and what Glance's WorkManager brings.
  Never here, from this file or from any library:
  INTERNET, location, exact alarms, battery-optimization exemptions, WRITE_CALENDAR, contacts,
  body sensors. `checkForbiddenPermissions` fails the build on the merged manifest if one appears.

  Backup: explicit, with an allowlist (res/xml/data_extraction_rules.xml, PLANNING.md §5). It is
  Android that sends the copy, if the reader turned backup on; Tempo has no network permission
  and gains none from this.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".TempoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tempo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tempo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
